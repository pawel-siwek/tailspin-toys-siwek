---
import type { Category, Publisher } from '../types/game';
import Button from './Button.astro';

interface Props {
    categories: Category[];
    publishers: Publisher[];
    /** Łączna liczba gier, używana jako początkowa wartość licznika wyników. */
    total: number;
}

const { categories, publishers, total } = Astro.props;
const focusRing = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    id="game-filters"
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-6"
    aria-label="Filtry gier"
    data-testid="game-filters"
>
    <fieldset class="space-y-3">
        <legend class="text-sm font-medium text-slate-300 mb-3">Kategorie</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 text-sm text-slate-100 cursor-pointer">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class={`h-4 w-4 rounded border-slate-600 bg-slate-900 accent-blue-500 ${focusRing}`}
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="filter-publisher" class="block text-sm font-medium text-slate-300 mb-2">Wydawca</label>
            <select
                id="filter-publisher"
                name="publisher"
                class={`rounded-lg bg-slate-900 border border-slate-600 text-slate-100 px-3 py-2 ${focusRing}`}
                data-testid="filter-publisher"
            >
                <option value="">Wszyscy wydawcy</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>
        <Button type="reset" size="sm" data-testid="filter-reset">Wyczyść filtry</Button>
    </div>

    <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-result-count" data-total={total}>
        Wyświetlono {total} z {total} gier
    </p>
</form>

<script>
    const form = document.getElementById('game-filters') as HTMLFormElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const noResults = document.getElementById('no-results');
    const counter = form?.querySelector<HTMLElement>('[data-testid="filter-result-count"]');

    function applyFilters(): void {
        if (!form) return;
        const data = new FormData(form);
        const categoryIds = data.getAll('category').map(String);
        const publisherId = String(data.get('publisher') ?? '');

        let visible = 0;
        for (const card of cards) {
            const matches =
                (categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '')) &&
                (publisherId === '' || card.dataset.publisherId === publisherId);
            card.hidden = !matches;
            if (matches) visible++;
        }

        if (grid) grid.hidden = visible === 0;
        if (noResults) noResults.hidden = visible !== 0;
        if (counter) counter.textContent = `Wyświetlono ${visible} z ${cards.length} gier`;
    }

    form?.addEventListener('change', applyFilters);
    // Reset formularza przywraca kontrolki dopiero po zdarzeniu, więc filtrujemy w następnym cyklu.
    form?.addEventListener('reset', () => setTimeout(applyFilters, 0));
    form?.addEventListener('submit', (event) => event.preventDefault());
</script>
